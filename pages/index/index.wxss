.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  background:
    radial-gradient(circle at 12% 2%, rgba(255, 255, 255, 0.92), transparent 260rpx),
    radial-gradient(circle at 86% 18%, rgba(246, 214, 126, 0.34), transparent 250rpx),
    linear-gradient(180deg, #e0eee8 0%, #b6d0c6 45%, #759587 100%);
  overflow: hidden;
}

.ambient {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.ambient image {
  position: absolute;
  width: 96rpx;
  height: 136rpx;
  opacity: 0.18;
  filter: blur(1rpx);
}

.ambient image:nth-child(1) {
  top: 112rpx;
  right: -18rpx;
  transform: rotate(14deg);
}

.ambient image:nth-child(2) {
  top: 420rpx;
  left: -28rpx;
  transform: rotate(-18deg);
}

.ambient image:nth-child(3) {
  right: 28rpx;
  bottom: 180rpx;
  transform: rotate(10deg);
}

.topbar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.game-name {
  display: block;
  color: #17392d;
  font-size: 42rpx;
  font-weight: 900;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.45);
}

.tagline {
  display: block;
  margin-top: 8rpx;
  color: rgba(36, 65, 55, 0.72);
  font-size: 24rpx;
  font-weight: 700;
}

.coin-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(255, 245, 191, 0.88);
  border-radius: 999rpx;
  background: linear-gradient(180deg, #416a4f, #14392b);
  color: #fff8dc;
  font-size: 28rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(34, 62, 51, 0.22);
}

.coin-icon {
  color: #ffd95e;
}

.hero-card {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 24rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.84), rgba(237, 247, 241, 0.76)),
    rgba(255, 255, 255, 0.72);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    0 20rpx 60rpx rgba(43, 75, 63, 0.18);
}

.level-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.level-label,
.progress text:last-child,
.metrics text:last-child {
  display: block;
  color: rgba(36, 65, 55, 0.64);
  font-size: 22rpx;
  font-weight: 750;
}

.level-value {
  display: block;
  margin-top: 6rpx;
  color: #244137;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1;
}

.progress {
  display: grid;
  place-items: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(180deg, #35644e, #17392d);
  color: white;
}

.progress text:first-child {
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.metrics view {
  padding: 16rpx 10rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.62);
  text-align: center;
}

.metrics text:first-child {
  display: block;
  color: #244137;
  font-size: 34rpx;
  font-weight: 950;
}

.toast {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(70, 105, 88, 0.92), rgba(36, 65, 55, 0.92));
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.45;
}

.toast-win {
  background: #d8892e;
}

.board-shell {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.72), transparent 420rpx),
    linear-gradient(135deg, rgba(244, 250, 246, 0.9), rgba(203, 221, 214, 0.84)),
    #d8e4df;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -12rpx 22rpx rgba(36, 65, 55, 0.08),
    0 30rpx 72rpx rgba(28, 54, 44, 0.3);
}

.board-glow {
  position: absolute;
  inset: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0));
  pointer-events: none;
}

.board {
  position: relative;
  display: grid;
  gap: 10rpx;
}

.cols-5 {
  grid-template-columns: repeat(5, 1fr);
}

.cols-6 {
  grid-template-columns: repeat(6, 1fr);
}

.cell {
  aspect-ratio: 0.74;
  min-width: 0;
  border-radius: 14rpx;
}

.tile {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow:
    0 14rpx 22rpx rgba(38, 65, 52, 0.24),
    0 2rpx 0 rgba(255, 255, 255, 0.34);
  transition:
    transform 140ms ease,
    filter 140ms ease;
}

.tile-image {
  display: block;
  width: 100%;
  height: 100%;
}

.empty {
  background: rgba(42, 72, 60, 0.1);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.26),
    inset 0 8rpx 20rpx rgba(36, 65, 55, 0.08);
}

.selected {
  transform: translateY(-6rpx);
  filter: drop-shadow(0 0 12rpx rgba(255, 184, 68, 0.78));
  box-shadow:
    0 20rpx 34rpx rgba(216, 137, 46, 0.42),
    0 0 0 5rpx rgba(255, 191, 79, 0.54);
}

.hint {
  filter: drop-shadow(0 0 10rpx rgba(81, 183, 125, 0.7));
}

.hint::after {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #3ed47a;
  box-shadow: 0 0 12rpx rgba(62, 212, 122, 0.95);
  content: "";
}

.rules {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.58);
  color: rgba(36, 65, 55, 0.76);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
}

.actions {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr 1.25fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.actions button {
  height: 82rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 82rpx;
}

.primary {
  background: linear-gradient(180deg, #355d49, #16382b);
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(23, 57, 45, 0.26);
}

.secondary {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.88), rgba(231, 241, 235, 0.82));
  color: #17392d;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.6);
}

button[disabled] {
  opacity: 0.5;
}

@media (max-width: 360px) {
  .page {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .board {
    gap: 8rpx;
  }
}
