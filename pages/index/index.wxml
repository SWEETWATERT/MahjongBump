<view class="page">
  <view class="ambient">
    <image src="/assets/tiles_ascii/wan1.png" mode="aspectFit"></image>
    <image src="/assets/tiles_ascii/tiao1.png" mode="aspectFit"></image>
    <image src="/assets/tiles_ascii/red.png" mode="aspectFit"></image>
  </view>

  <view class="topbar">
    <view>
      <text class="game-name">挪对对超解压</text>
      <text class="tagline">看似简单，玩着就沉下去了</text>
    </view>
    <view class="coin-pill">
      <text class="coin-icon">¥</text>
      <text>{{game.coins}}</text>
    </view>
  </view>

  <view class="hero-card">
    <view class="level-row">
      <view>
        <text class="level-label">关卡</text>
        <text class="level-value">第 {{game.level}} 关</text>
      </view>
      <view class="progress">
        <text>{{leftCount}}</text>
        <text>剩余</text>
      </view>
    </view>
    <view class="metrics">
      <view>
        <text>{{game.score}}</text>
        <text>得分</text>
      </view>
      <view>
        <text>{{game.steps}}</text>
        <text>步数</text>
      </view>
      <view>
        <text>{{game.combo}}</text>
        <text>连击</text>
      </view>
    </view>
  </view>

  <view class="toast {{game.status === 'win' ? 'toast-win' : ''}}">
    <text>{{game.toast}}</text>
  </view>

  <view class="board-shell">
    <view class="board-glow"></view>
    <view class="board cols-{{game.cols}}">
      <view
        wx:for="{{game.board}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="tapCell"
        class="cell {{item.empty ? 'empty' : 'tile'}} {{item.selected ? 'selected' : ''}} {{item.hint ? 'hint' : ''}} suit-{{item.suit}}"
      >
        <image wx:if="{{!item.empty}}" src="{{item.image}}" mode="aspectFit" class="tile-image"></image>
      </view>
    </view>
  </view>

  <view class="rules">
    <text>相邻相同可直接消除；同行或同列中间没有牌，也可以连线消除。</text>
  </view>

  <view class="actions">
    <button class="secondary" bindtap="shuffleBoard" disabled="{{!canShuffle}}">洗牌</button>
    <button class="secondary" bindtap="startGame">重开</button>
    <button wx:if="{{canNext}}" class="primary" bindtap="nextLevel">下一关</button>
    <button wx:else class="primary" disabled="{{true}}">消完过关</button>
  </view>
</view>
