<view class="container">
  <view class="top-bar">
    <view class="info-pill">时间：{{time}}</view>
    <view class="info-pill">分数：{{score}}</view>
    <view class="info-pill">连击：{{combo}}</view>
  </view>

  <view class="notice {{noticeType}}">{{message}}</view>

  <canvas
    type="2d"
    id="gameCanvas"
    class="game-canvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    disable-scroll="true"
    bindtouchstart="onCanvasTouch"
  ></canvas>

  <view class="bottom-bar">
    <button class="action-button" bindtap="onShuffle">洗牌</button>
    <button class="action-button primary" bindtap="onHint">提示</button>
    <button class="action-button" bindtap="onRestart">重来</button>
  </view>
</view>
