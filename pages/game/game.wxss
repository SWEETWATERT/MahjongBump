page {
  min-height: 100vh;
  background: #0d7a4d;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 36rpx;
  background: linear-gradient(180deg, #118454 0%, #0b6e45 48%, #075c39 100%);
}

.top-bar {
  display: flex;
  gap: 14rpx;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.info-pill {
  flex: 1;
  min-height: 78rpx;
  line-height: 78rpx;
  text-align: center;
  border-radius: 16rpx;
  color: #fff7d7;
  background: rgba(2, 65, 37, 0.76);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.18), 0 8rpx 16rpx rgba(0, 0, 0, 0.18);
  font-size: 34rpx;
  font-weight: 700;
}

.notice {
  min-height: 68rpx;
  line-height: 68rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
  text-align: center;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.13);
  font-size: 30rpx;
  font-weight: 600;
}

.notice.error {
  color: #fff6f6;
  background: rgba(255, 62, 62, 0.56);
}

.notice.success {
  color: #164426;
  background: #fff2a8;
}

.game-canvas {
  display: block;
  margin: 0 auto 24rpx;
  border-radius: 26rpx;
  box-shadow: inset 0 6rpx 18rpx rgba(0, 0, 0, 0.18), 0 14rpx 30rpx rgba(0, 0, 0, 0.24);
}

.bottom-bar {
  display: flex;
  gap: 18rpx;
  justify-content: center;
}

.action-button {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border-radius: 18rpx;
  color: #0c5436;
  background: #fff8d8;
  box-shadow: 0 8rpx 0 #d3a83f, 0 12rpx 22rpx rgba(0, 0, 0, 0.22);
  font-size: 36rpx;
  font-weight: 800;
}

.action-button::after {
  border: 0;
}

.action-button.primary {
  color: #ffffff;
  background: #f6a623;
  box-shadow: 0 8rpx 0 #bc7211, 0 12rpx 22rpx rgba(0, 0, 0, 0.24);
}
